generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id           String       @id @default(uuid())
  name         String
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  deployments  Deployment[]
  createdAt    DateTime     @default(now())
}

model Deployment {
  id        String    @id @default(uuid())
  projectId String
  status    String
  url       String?
  project   Project   @relation(fields: [projectId], references: [id])
  createdAt DateTime  @default(now())
}

model McpConnection {
  id        String    @id @default(uuid())
  name      String
  endpoint  String
  apiKey    String
  createdAt DateTime  @default(now())
}
